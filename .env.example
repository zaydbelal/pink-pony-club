GEMINI_API_KEY=
# Optional override, defaults to gemini-3.6-flash
GEMINI_MODEL=
# Optional override, defaults to gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
# Optional override in ms, defaults to 600000 (10 min) - demo cadence for the
# in-process weekly report scheduler; a real deployment would use a longer
# interval, or the n8n workflow below instead of an in-process interval.
REPORT_INTERVAL_MS=
# Set to false if you're running n8n/weekly-reports-workflow.json instead of
# the in-process scheduler, so reports aren't generated twice. Defaults to true.
SCHEDULER_ENABLED=
# Where the Next.js dev/prod server proxies /api/* requests to.
# Defaults to http://127.0.0.1:8000 (the Python backend's default uvicorn port).
BACKEND_URL=
# Used by n8n/weekly-reports-workflow.json (set this in your n8n instance's
# environment, not here) to reach the backend. Defaults to http://127.0.0.1:8000.
CLASSPILOT_BACKEND_URL=
