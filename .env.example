GEMINI_API_KEY=
# Optional override, defaults to gemini-3.6-flash
GEMINI_MODEL=
# Optional override, defaults to gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
# Optional override in ms, defaults to 600000 (10 min) - demo cadence for the
# autonomous weekly report scheduler; a real deployment would use a longer
# interval (or a real cron/queue trigger instead of an in-process interval)
REPORT_INTERVAL_MS=
# Where the Next.js dev/prod server proxies /api/* requests to.
# Defaults to http://127.0.0.1:8000 (the Python backend's default uvicorn port).
BACKEND_URL=
